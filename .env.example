# Copy this file to .env.local and fill in your own Supabase project's values.
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — only needed if/when the AI assistant and recommendation engine
# call a real LLM instead of the canned demo responses.
VITE_AI_PROVIDER=none
